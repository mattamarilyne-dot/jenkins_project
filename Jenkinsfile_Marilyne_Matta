pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
        PATH = "/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Setup') {
            steps {
                sh 'python3 -m venv "$VIRTUAL_ENV"'
                sh '"$VIRTUAL_ENV/bin/python" -m pip install -r requirements.txt'
            }
        }

        stage('Lint') {
            steps {
                sh '"$VIRTUAL_ENV/bin/python" -m flake8 app.py'
            }
        }

        stage('Test') {
            steps {
                sh '"$VIRTUAL_ENV/bin/python" -m pytest -v'
            }
        }

        stage('Coverage') {
            steps {
                sh '"$VIRTUAL_ENV/bin/python" -m coverage run --source=app -m pytest -v'
                sh '"$VIRTUAL_ENV/bin/python" -m coverage report -m'
                sh '"$VIRTUAL_ENV/bin/python" -m coverage html'
                sh '"$VIRTUAL_ENV/bin/python" -m coverage xml'
                archiveArtifacts artifacts: 'htmlcov/**,coverage.xml'
            }
        }

        stage('Security Scan') {
            steps {
                sh '"$VIRTUAL_ENV/bin/python" -m bandit app.py'
            }
        }

        stage('Deploy') {
            steps {
                sh 'sh deploy.sh'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}